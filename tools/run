#!/usr/bin/env bash
# Runs the plugin's scripts in their own Python environment.
#
#   bash tools/run next_steps.py --dir ~/polako
#   bash tools/run --check          # only prepare the environment
#
# The first run creates the venv and installs tools/requirements.txt; later runs reinstall only
# if requirements.txt has changed. The venv lives in $POLAKO_VENV, by default
# ~/.local/share/polako/venv — outside the plugin folder, so it survives plugin updates.
#
# Exit codes handled by the hub:
#   3 — no working python3 (POLAKO_NEEDS_PYTHON)
#   4 — failed to install dependencies (POLAKO_DEPS_FAILED)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
VENV="${POLAKO_VENV:-${XDG_DATA_HOME:-$HOME/.local/share}/polako/venv}"
REQ="$ROOT/tools/requirements.txt"

say(){ printf 'polako: %s\n' "$*" >&2; }

UV="$(command -v uv 2>/dev/null || true)"
for c in "$HOME/.local/bin/uv" "$HOME/.cargo/bin/uv" /opt/homebrew/bin/uv /usr/local/bin/uv; do
  [ -z "$UV" ] && [ -x "$c" ] && UV="$c"
done

find_python(){
  for p in python3.13 python3.12 python3.11 python3.10 python3; do
    if command -v "$p" >/dev/null 2>&1 && "$p" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 10) else 1)' >/dev/null 2>&1; then
      command -v "$p"; return 0
    fi
  done
  return 1
}

ensure_venv(){
  if [ ! -x "$VENV/bin/python" ]; then
    mkdir -p "$(dirname "$VENV")"
    if [ -n "$UV" ]; then
      say "creating the environment (uv; Python will be downloaded if missing)…"
      "$UV" venv -q --python 3.12 "$VENV" || { echo "POLAKO_DEPS_FAILED: uv venv" >&2; exit 4; }
    else
      PY="$(find_python)" || { echo "POLAKO_NEEDS_PYTHON: Python 3.10+ is required" >&2; exit 3; }
      say "creating the environment ($PY)…"
      "$PY" -m venv "$VENV" || { echo "POLAKO_DEPS_FAILED: venv was not created" >&2; exit 4; }
    fi
  fi
  local hash; hash="$(cksum "$REQ" | cut -d' ' -f1)"
  if [ ! -f "$VENV/.req-$hash" ]; then
    say "installing dependencies, one time only…"
    if [ -n "$UV" ]; then
      "$UV" pip install -q --python "$VENV/bin/python" -r "$REQ" || { echo "POLAKO_DEPS_FAILED" >&2; exit 4; }
    else
      "$VENV/bin/python" -m pip install -q --disable-pip-version-check -r "$REQ" || { echo "POLAKO_DEPS_FAILED" >&2; exit 4; }
    fi
    rm -f "$VENV"/.req-* && touch "$VENV/.req-$hash"
    say "done"
  fi
}

case "${1:-}" in
  --check)
    ensure_venv; echo "ok: $VENV"; exit 0 ;;
  ""|-h|--help)
    sed -n '2,14p' "$0"; exit 0 ;;
esac

ensure_venv
SCRIPT="$1"; shift
case "$SCRIPT" in
  *.sh) exec bash "$ROOT/tools/$SCRIPT" "$@" ;;
  *)    exec "$VENV/bin/python" "$ROOT/tools/$SCRIPT" "$@" ;;
esac
