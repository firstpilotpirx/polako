{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "polako/profile.schema.json",
  "title": "Learner profile",
  "description": "prep/profile.yaml — wizard answers. Written by state.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {"type": "integer", "minimum": 1},
    "explain": {"type": "string", "description": "Explanation language (translations, UI): ru by default"},
    "level": {"enum": ["a0", "a1", "a2", "b1", "b2"]},
    "goal": {"type": "integer", "minimum": 1, "maximum": 200, "description": "New words a day"},
    "retention": {"type": "number", "minimum": 0.7, "maximum": 0.97, "description": "FSRS target recall"},
    "listening": {"type": "boolean", "description": "Listening side on (needs a Serbian/Croatian/Bosnian voice)"},
    "typing": {"type": "boolean", "description": "Typing side on (off by default)"},
    "situations": {"type": "array", "items": {"type": "string"}},
    "interests": {"type": "array", "items": {"type": "string"}},
    "why": {"type": "string", "description": "Why Serbian: life in Serbia, work, family, travel"},
    "started": {"type": "string"},
    "wizard": {"type": "object", "description": "Wizard progress: {done: [steps], skipped: [steps], finished: bool}"}
  }
}
